{
  "name": "contract-testing-pact",
  "version": "1.0.0",
  "description": "Consumer-driven contract testing framework using Pact.io for microservices",
  "author": "Quvantic <info@quvantic.com> (https://quvantic.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaautomation/contract-testing-pact.git"
  },
  "homepage": "https://quvantic.com",
  "bugs": {
    "url": "https://github.com/mustafaautomation/contract-testing-pact/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start:provider": "tsx src/provider/server.ts",
    "test": "vitest run tests/unit && vitest run tests/consumer && vitest run tests/provider",
    "test:consumer": "vitest run tests/consumer",
    "test:provider": "vitest run tests/provider",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pact:publish": "tsx scripts/publish-pacts.ts",
    "broker:up": "docker compose up -d",
    "broker:down": "docker compose down",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
